# AmiForge project
[project]
name=asmdemo
output=asmdemo
cc=gcc
cxx=g++
cflags=-O0 -gstabs -Wall
cxxflags=-O0 -gstabs+ -Wall
asflags=-gstabs
ldflags=
libs=-lauto
objdir=obj
args=
console=
stopatmain=1
description=C calling a PowerPC assembler function (fastsum.s); step into it with F11 and F8

[files]
file=main.c
file=fastsum.s
