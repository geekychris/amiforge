# AmiForge project
[project]
name=dirsize
output=dirsize
cc=gcc
cxx=g++
cflags=-O0 -gstabs -Wall
cxxflags=-O0 -gstabs+ -Wall
asflags=-gstabs
ldflags=
libs=-lauto
objdir=obj
args=SDK:Include TOP 3
console=
stopatmain=1
description=Shell tool: space used by a drawer, totalled by file type (ReadArgs, ExamineDir recursion, Ctrl-C)\nstd::map totals and sorted output; RAII classes for the arguments and each drawer's context.

[files]
file=dirsize.cpp
