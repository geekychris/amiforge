# AmiForge project
[project]
name=shapes
output=shapes
cc=gcc
cxx=g++
cflags=-O0 -gstabs -Wall
cxxflags=-O0 -gstabs+ -Wall
asflags=-gstabs
ldflags=
libs=-lauto
objdir=obj
args=
console=
stopatmain=1
description=C++: classes, virtual functions, std::vector and std::unique_ptr

[files]
file=shapes.cpp
