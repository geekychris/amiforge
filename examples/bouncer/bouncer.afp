# AmiForge project
[project]
name=bouncer
output=bouncer
cc=gcc
cxx=g++
cflags=-O0 -gstabs -Wall
cxxflags=-O0 -gstabs+ -Wall
asflags=-gstabs
ldflags=
libs=-lauto
objdir=obj
args=
console=
stopatmain=0
description=C++ using the OS: an Intuition window with a GadTools menu, graphics.library drawing and timer.device pacing

[files]
file=bouncer.cpp
file=window.cpp
file=window.h

[watches]
watch=balls.size()
